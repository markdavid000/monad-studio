    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "groq-sdk": "1.6.0",
    "lucide-react": "1.71.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.57.17",
